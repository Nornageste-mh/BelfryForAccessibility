# ============================================================
#  《钟塔 Belfry》无障碍项目 — 版本控制排除规则
# ============================================================

# ------------------------------------------------------------
# 1. 游戏版权内容：绝不入库
#
#    以下目录是从「已购正版游戏」中提取 / 反编译得到的，属于游戏
#    著作权人的文字与代码资产。入库并推送等同于再分发 ——
#    在绝大部分国家和地区，再分发这类内容都是不被允许的。
#
#    它们都可以在本机重新生成（见 README.md「如何复现分析」）。
# ------------------------------------------------------------
/extracted/
/decompiled/
/decompiled_fp/

# ------------------------------------------------------------
# 2. 第三方二进制与下载物：可由 build.ps1 重新获取
# ------------------------------------------------------------
/mod/bep_dl/
/mod/nvda_dl/
/mod/dl/
/mod/*.zip

# 发布产物（由 mod\tools\makezip.ps1 手工打包）。只进 GitHub Releases，
# 不进版本库 —— 否则每次发版都会往历史里塞一个几十 MB 的二进制，
# 而且 git 没法对 zip 做增量，重打包一次就多存一整份。
/mod/dist/

# 安装包目录只保留自产的说明文件；BepInEx 运行时、NVDA 客户端 DLL
# 等第三方二进制由 mod/build.ps1 重新组装。
#
# 这里没有安装程序：补丁是 BepInEx 运行时挂载的，不修改游戏文件，
# 安装就是「把 package\ 里的东西拷进游戏根目录」，手写说明足够。
/mod/package/*
!/mod/package/安装说明.md
!/mod/package/常见问题.md

# ------------------------------------------------------------
# 3. 实机验证的临时产物
#
#    probe/evidence/ 里只入库**不含剧本文本**的证据：
#      · scene_tree.txt        Unity 对象名（不是剧情内容）
#      · probe_full_dump.log   补丁点清单与场景树（探针不打台词）
#      · README.md             实测结论摘要
#
#    下面这些一律不入库：
#      · 会话日志（[朗读] 行就是游戏剧本原文）
#      · 游戏截图（画面本身就是游戏美术资源）
#    「本仓库不包含任何游戏资源」这句话必须字面成立。
# ------------------------------------------------------------
/probe/plugin/bin/
/probe/plugin/obj/
/probe/shot*.png
/probe/*.log
/probe/evidence/*.log
/probe/evidence/*.png
!/probe/evidence/probe_full_dump.log

# ------------------------------------------------------------
# 4. .NET 构建产物
# ------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# ------------------------------------------------------------
# 5. 提交信息用的脚手架文件
#
#    带中文和换行的提交信息塞进 PowerShell 命令行会被吃掉引号，
#    所以本项目的习惯是写进临时文件再用 `git commit -F` 提交。
#    但那个文件**不能写在仓库里**：第一个提交里混进过 tmp_commit_msg.txt，
#    第二个版本又混进过 tmp_msg.txt，各自还得再补一条「移除临时提交信息文件」
#    的提交去擦屁股 —— 而发布标签恰好打在了那两条上。
#
#    正确做法是写到仓库外或 $env:TEMP：
#        git commit -F "$env:TEMP\msg.txt"
#    下面这些是兜底；tools\check-staged.ps1 里还有一道硬闸门。
# ------------------------------------------------------------
tmp_commit_msg.txt
tmp_msg.txt
commit_msg.txt
msg.txt
_review_diff.txt
*.diff

# ------------------------------------------------------------
# 6. 系统杂物
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
